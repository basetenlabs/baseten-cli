    "/v1/routes": {
      "get": {
        "summary": "Lists routes",
        "x-codeSamples": [
          {
            "lang": "bash",
            "source": "curl --request GET \\\n--url {{API_BASE}}/v1/routes \\\n--header \"Authorization: Bearer $BASETEN_API_KEY\"\n"
          },
          {
            "lang": "python",
            "source": "import requests\nimport os\nAPI_KEY = os.environ.get(\"BASETEN_API_KEY\", \"<YOUR_API_KEY>\")\nurl = \"{{API_BASE}}/v1/routes\"\n\nheaders = {\"Authorization\": f\"Bearer {API_KEY}\"}\n\nresponse = requests.request(\n    \"GET\",\n    url,\n    headers=headers,\n    params={'cursor': None, 'team_id': None, 'name': None}\n)\n\nprint(response.text)"
          }
        ],
        "description": "Lists routes you can invoke, newest first, optionally filtered by team and exact name.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor returned by a previous page. Omit to fetch the first page.",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of items to return.",
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "required": false,
            "description": "Filter by owning team ID. Preserved by the cursor; if repeated, must match the original filter.",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Team Id"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Filter by exact route name. Preserved by the cursor; if repeated, must match the original filter.",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoutesResponseV1"
                }
              }
            }
          }
        },
        "x-stability": "unstable"
      },
      "post": {
        "summary": "Creates a route",
        "x-codeSamples": [
          {
            "lang": "bash",
            "source": "curl --request POST \\\n--url {{API_BASE}}/v1/routes \\\n--header \"Authorization: Bearer $BASETEN_API_KEY\" \\\n--data '{\n  \"name\": \"my-org/assistant\",\n  \"team_id\": \"abc1234\",\n  \"display_name\": \"Assistant\",\n  \"target\": {\n    \"model_api\": \"zai-org/GLM-5.3\",\n    \"type\": \"BASETEN_MODEL_API\"\n  },\n  \"description\": \"Assistant for code review and debugging.\"\n}'"
          },
          {
            "lang": "python",
            "source": "import requests\nimport os\nAPI_KEY = os.environ.get(\"BASETEN_API_KEY\", \"<YOUR_API_KEY>\")\nurl = \"{{API_BASE}}/v1/routes\"\n\nheaders = {\"Authorization\": f\"Bearer {API_KEY}\"}\n\nresponse = requests.request(\n    \"POST\",\n    url,\n    headers=headers,\n    json={'name': 'my-org/assistant', 'team_id': 'abc1234', 'display_name': 'Assistant', 'target': {'model_api': 'zai-org/GLM-5.3', 'type': 'BASETEN_MODEL_API'}, 'description': 'Assistant for code review and debugging.'}\n)\n\nprint(response.text)"
          }
        ],
        "description": "Dedicated deployment targets are not supported.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRouteRequestV1"
              }
